[core]
	autocrlf = false

[init]
	defaultBranch = develop

[user]
	name = growlingchaos
  email = growlingchaos@gmail.com

[rebase]
  autosquash = true
  updateRefs = true

[diff]
  tool = difft

[difftool]
  prompt = false

[difftool "difft"]
  cmd = /usr/bin/difft $LOCAL $REMOTE

[merge]
	tool = nvimdiff

[mergetool]
  prompt = false
  keepBackup = false

[mergetool "nvimdiff"]
  layout = "LOCAL,BASE,REMOTE / MERGED"

