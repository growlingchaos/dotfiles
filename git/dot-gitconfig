[core]
	autocrlf = false

[init]
	defaultBranch = develop

[user]
	name = growlingchaos
  email = growlingchaos@gmail.com

[rebase]
  autosquash = true
  updateRefs = true

[diff]
  tool = difft

[difftool]
  prompt = false

[difftool "difft"]
  cmd = /usr/bin/difft

[merge]
	tool = intellij

[mergetool]
  prompt = false
  keepBackup = false

[mergetool "intellij"]
  cmd = /home/gpavan/.local/share/JetBrains/Toolbox/apps/intellij-idea-ultimate/bin/idea.sh merge “$LOCAL” “$REMOTE” “$BASE” “$MERGED”
  trustExitCode = true

